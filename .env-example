POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

SPRING_USER=
SPRING_PASSWORD=
SPRING_PORT=

UI_PORT=

# Gere uma chave aleatoria JWT
JWT_SECRET=
# Tempo de horas que o token irá durar
JWT_EXPIRATION=24

DB_DRIVER=org.postgresql.Driver
HIBERNATE_DDL_AUTO=validate

# Origens liberadas no CORS (ex.: https://seu-app.vercel.app), separadas por virgula
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Armazenamento de arquivos: local | supabase
STORAGE_TYPE=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=files

# E-mail (SMTP) para o "esqueci minha senha". Sem MAIL_HOST, o link aparece só no log da API.
# Exemplos: Gmail (smtp.gmail.com:587 + senha de app), Resend (smtp.resend.com:587, usuário "resend"), Mailtrap para testes
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Banca de Materiais <no-reply@seu-dominio.com>
# Endereço da UI, usado no link do e-mail
FRONTEND_URL=http://localhost:3000

# URL da API usada pela UI (Next.js embute no build). Local: copie para ui/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8080
