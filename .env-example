POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

SPRING_USER=
SPRING_PASSWORD=
SPRING_PORT=

UI_PORT=

# Gere uma chave aleatoria JWT
JWT_SECRET=
# Tempo de horas que o token irá durar
JWT_EXPIRATION=24

DB_DRIVER=org.postgresql.Driver
HIBERNATE_DDL_AUTO=validate

# Origens liberadas no CORS (ex.: https://seu-app.vercel.app), separadas por virgula
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Armazenamento de arquivos: local | supabase
STORAGE_TYPE=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=files
