# Imagem de desenvolvimento usada pelo docker-compose (que monta ./ui em /app e roda "npm run dev").
# Os estágios de build de produção que ficavam aqui nunca eram usados (o compose só monta o último estágio).
FROM node:22-alpine

WORKDIR /app

# npm ci instala exatamente o package-lock.json (o npm install podia atualizar versões a cada build)
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund

COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]
